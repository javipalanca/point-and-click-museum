# Copy to .env (never commit it) and fill in. Docker Compose reads it automatically.

# Public URL of the site (canonical links, hreflang, sitemap) and the port published on the server.
BASE_URL=http://localhost:8080
PORT=8080
# Behind another reverse proxy on the same machine (e.g. pointandclickle's Traefik, see deploy/traefik/README.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# PORT=127.0.0.1:8080
# 1 = public build without your local game collection; 0 = include assets/games and data/arcade.local.json
PUBLIC=1
# Games inbox: drop .zip / .jsdos files in this folder on the server and they appear in the DOSBox room
# (checked every GAMES_WATCH seconds). Everything there is served to every visitor.
GAMES_DIR=./games
# (the folder must exist before `docker compose up`: Docker Desktop for Mac cannot create it)
GAMES_WATCH=15

# Automatic catalogue (ScummVM, Internet Archive, GOG): hours between refreshes (0 = never), new editions downloaded
# and checked per refresh, largest download, games kept by the download proxy and new downloads per visitor IP and hour.
CATALOG_EVERY=24
GAMES_VALIDATE_PER_RUN=20
GAMES_MAX_MB=400
GAMES_CACHE_MB=2048
GAMES_RATE=20

# Control panel of the catalogue at /admin/ (sync, downloads and errors, sources, rights, test emulator).
# Empty = no panel. Use a long password; behind HTTPS set ADMIN_COOKIE_SECURE=1. Never commit .env.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=0

# Statistics. GA_MEASUREMENT_ID (G-XXXXXXX, from Google Analytics → Admin → Data streams): Google Analytics 4,
# loaded only after the visitor accepts the cookie banner. STATS_URL: the museum's own statistics, without cookies or
# stored IPs, shown in the panel (tab «Estadísticas»); leave it empty to switch them off. Both are rebuilt into the pages.
GA_MEASUREMENT_ID=
# CLARITY_ID (Microsoft Clarity → Settings → Overview → Project ID): heatmaps and session recordings, with the same
# consent as Google Analytics; Murray's chat and «bring your own game» are masked in the recordings.
CLARITY_ID=
STATS_URL=/api/stats

# Murray, the talking skull: any OpenAI-compatible chat completions API serving an open model.
# These values only reach the murray container; never the browser or the static files.
# Examples of base URL:
#   Ollama on this host          http://host.docker.internal:11434/v1
#   vLLM / llama.cpp / LM Studio http://host.docker.internal:8000/v1
#   remote provider              https://your-provider.example/v1
# Model: the name your server uses for Qwen 3.8 (e.g. "qwen3.8" in Ollama, the Hugging Face id in vLLM).
# Leave the URL or the model empty and Murray answers from the museum's database only ("display-case mode").
MURRAY_LLM_BASE_URL=
MURRAY_LLM_API_KEY=
MURRAY_LLM_MODEL=
# 1 = offer the museum lookup tools via function calling (falls back automatically if the server rejects them)
MURRAY_LLM_TOOLS=1
MURRAY_LLM_TEMPERATURE=0.7
MURRAY_LLM_MAX_TOKENS=900
# 0 = ask the model not to "think" before answering (Qwen writes a hidden reasoning first, which delays the first
# word by seconds). Sends chat_template_kwargs.enable_thinking=false (vLLM, SGLang, llama.cpp) and drops it by itself if
# the server rejects it. 1 = let it think (slower, maybe more careful).
MURRAY_LLM_THINK=0
# Optional JSON merged into each request (overrides the above if it sets chat_template_kwargs)
MURRAY_LLM_EXTRA=
# To measure where the time goes:  docker compose exec murray python3 server/murray.py --probe "¿Qué es SCUMM?"

# Topic guardrails: strict (rules + the model classifies doubtful messages; one short extra call for those),
# rules (no extra call; doubtful messages are refused) or off.
MURRAY_GUARD=strict

# Requests per visitor IP every 10 minutes, and model requests per day for the whole server.
MURRAY_RATE=30
MURRAY_DAILY_LIMIT=2000
